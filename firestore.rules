rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ใส่อีเมล Google ของ Admin (เพิ่มได้หลายคน คั่นด้วย ,)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ADMIN_EMAIL@gmail.com'];
    }

    function validSlot(d) {
      return d.keys().hasOnly(['date', 'start', 'end', 'count', 'giftIds', 'giftText', 'createdAt'])
        && d.date in ['2026-10-13', '2026-10-14', '2026-10-15']
        && d.start is int && d.end is int
        && d.start >= 540 && d.end <= 1200 && d.start < d.end
        && d.count is int && d.count >= 1 && d.count <= 20
        && d.giftIds is list && d.giftIds.size() <= 10
        && d.giftText is string && d.giftText.size() <= 300
        && d.createdAt == request.time;
    }

    // ช่วงเวลาที่จอง: ทุกคนเห็น (ไม่มีชื่อ) ใครก็จองได้โดยไม่ต้องล็อกอิน
    match /slots/{id} {
      allow read: if true;
      allow create: if validSlot(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // ชื่อผู้เยี่ยม: เฉพาะ Admin อ่านได้ ต้องสร้างคู่กับ slot ที่มี id เดียวกัน
    match /visits/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/slots/$(id))
        && existsAfter(/databases/$(database)/documents/slots/$(id));
    }

    // รายการของ: ทุกคนเห็น Admin แก้ได้คนเดียว
    match /gifts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
